<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>user data</title>
    <link rel="stylesheet" href="/show.css" />
  </head>
  <body>
    <table>
      <thead>
        <th>profile pic</th>
        <th>name</th>
        <th>email</th>
      </thead>

      <% for (const user of userDetails) {%>
      <tr>
        <td>
          <img src="<%= user.profilePic %>" width="50" alt="user Image" />
        </td>
        <td><%= user.username %></td>
        <td><%= user.email %></td>
        <td>
          <form
            method="post"
            action="/delete/<%= user._id %>?_method=DELETE"
            onclick="alert('Are you sure delete paramenent delete your data')"
          >
            <button onclick="">delete</button>
          </form>
        </td>
      </tr>
      <%} %>
    </table>
  </body>
</html>
