<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>root routs</title>
    <link rel="stylesheet" href="/index.css" />
  </head>
  <body>
    <h1>show all student list</h1>
    <table>
      <thead>
        <th>name</th>
        <th>rollNo</th>
        <th>className</th>
        <th>section</th>
        <th>email</th>
        <th>phone</th>
        <th>createdAt</th>
      </thead>

      <% for (const student of allList) {%>
      <tr>
        <td><%= student.name%></td>
        <td><%= student.rollNo%></td>
        <td><%= student.className%></td>
        <td><%= student.section%></td>
        <td><%= student.email%></td>
        <td><%= student.phone%></td>
        <td><%= student.createdAt%></td>
        <td><a href="/student/edit/<%= student._id %>">Update</a></td>
        <td>
          <form
            action="/student/delete/<%= student._id %>?_method=DELETE"
            method="POST"
            style="display: inline"
          >
            <button
              type="submit"
              onclick="return confirm('Are you sure you want to delete this student?');"
            >
              Delete
            </button>
          </form>
        </td>
      </tr>
      <div class="edit">
        <a href="/student/edit/<%= student._id %>">edit</a>
      </div>
      <%} %>
    </table>
    <div class="add">
      <a href="/student/add">add</a>
    </div>
  </body>
</html>
